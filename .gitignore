# Xcode
build/
DerivedData/
# A worktree-local DerivedData, so parallel agent worktrees do not contend for the shared one's
# build lock. It is a build product either way and must never be tracked.
.dd/
.ddrel/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
.swiftpm/
Packages/
*.moved-aside

# Handoff bundle, unpacked
_unzipped/

# Seed pipeline: the raw DataSF download is ~50 MB and regenerable via Tools/build_seed.py
Fixtures/raw/

# Python tooling
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Bundled seed: an 88 MB build product of Tools/build_seed.py, byte-for-byte reproducible.
# Regenerate with: python3 Tools/build_seed.py
# schema.sql beside it IS checked in — it is the readable contract; the .sqlite is just its output.
Fixtures/seed/*.sqlite
Cypress/Resources/cypress-seed.sqlite

# Worktrees created for parallel agent runs.
.claude/

# Per-worktree DerivedData for agent builds. One directory per agent, inside that agent's
# own worktree, so parallel builds cannot collide.
.ddsnap/
.ddphoto/
.ddspecies/
.ddalmanac/
.ddseed/
.ddcity/
.ddphotoown/
# Build logs from a test run, written into the worktree root.
*.log
# Verification screenshots taken against a running simulator. Evidence for a round of work,
# regenerable by walking the app; not source.
shots/
.ddland/

# Publisher output (Tools/publish_cities.py): per-city seed files + manifest,
# regenerable from Fixtures/seed/cypress-seed.sqlite; never source.
/dist/

# Species maps derived by a build. The checked-in Fixtures/*_species_map.csv are the
# record; these are what the current build derived, written here so a build never
# modifies a tracked input. Update the tracked copy with --write-species-map.
Fixtures/build/

# The web app (W-A, docs/design-proposals/2026-09-10-web-version.md). Three build products and
# nothing else — the two manifests, package.json and package-lock.json, ARE source and are
# tracked. `npm ci` reads the lockfile and refuses when it disagrees with package.json, which is
# what makes the Docker image reproducible; an ignored lockfile would make every image a fresh
# resolution of a version range.
#
# `.astro/` is the types directory Astro regenerates on every build and dev start — the same
# category as graphify-out/, output ABOUT the source, read by the editor and by `astro check`.
web/node_modules/
web/dist/
web/.astro/
# Local environment for `astro dev`. Nothing in v1 needs one; it is here because the day
# something does is not the day to be discovering that this line is missing.
web/.env
web/.env.*
