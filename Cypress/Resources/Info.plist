		<string>AlegreyaSans-Regular.ttf</string>
		<string>AlegreyaSans-Medium.ttf</string>
		<string>AlegreyaSans-Bold.ttf</string>
		<string>AlegreyaSans-ExtraBold.ttf</string>
		<string>AlegreyaSans-Italic.ttf</string>
		<string>SplineSansMono-Regular.ttf</string>
		<string>SplineSansMono-Medium.ttf</string>
		<string>SplineSansMono-SemiBold.ttf</string>
