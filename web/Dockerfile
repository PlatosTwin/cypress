# The public web surface (W-A, docs/design-proposals/2026-09-10-web-version.md).
#
# Node is pinned to an exact patch in BOTH stages, and `web/test/toolchain.test.ts` fails if
# either one drifts from `package.json` engines.node or from `.nvmrc`. The pin is not caution
# for its own sake: the read path this app is being built for is `node:sqlite`, which ships in
# the standard library and is documented as experimental and free to change. A floating tag is a
# runtime that can change under the one API the whole design rests on.
#
# `-slim` rather than `-alpine`: Astro's build reaches for prebuilt native binaries (esbuild,
# rollup) that are published for glibc and, on musl, either fall back to a slower path or need a
# toolchain in the image to build. Debian slim costs about 60 MB over alpine and removes the
# whole question. `scratch` — what `server/Dockerfile` uses — is not available here at all: this
# is an interpreted runtime, the interpreter has to be in the image.
FROM node:24.13.1-slim AS build
WORKDIR /app

# The manifest pair first, so editing a page does not re-resolve the dependency graph.
#
# `npm ci`, never `npm install`: it installs the lockfile exactly and fails if the lockfile and
# package.json disagree, which is the property that makes the image reproducible and makes the
# lockfile worth committing.
COPY package.json package-lock.json ./
RUN npm ci

# Everything else the build reads. Copied as a directory list rather than `COPY . .` for
# `server/Dockerfile`'s reason inverted: there the allowlist rotted and a missing package broke
# the build loudly; here the risk is the opposite one, a `.env` or a stray log being baked into
# a public image. `.dockerignore` beside this file is the second half of that.
COPY astro.config.mjs tsconfig.json ./
COPY src ./src

# The four font faces the OpenGraph card is rasterized with, and their license.
#
# **They are copied because the rasterizer takes fonts as paths on disk and this build context is
# `web/`.** `@resvg/resvg-js` 2.6.2 has `fontFiles` and `fontDirs` and no buffer form, so the faces
# have to be real files in the running container; `docker build … web` means nothing outside this
# directory can be COPYed, which is why `web/fonts/` exists at all (generated by
# `npm run fonts`, checked byte-for-byte against `Cypress/Resources/Fonts/` by the suite).
#
# Here in the BUILD stage so the image is one `COPY --from` below rather than two sources, and
# because `web/test/ogRaster.test.ts` asserts this directory reaches the runtime stage: with
# `loadSystemFonts: false` — the setting that makes the card look the same everywhere — resvg
# draws NOTHING for a family it cannot resolve. A card with no words on it is what a forgotten
# COPY looks like, and `MissingCardFonts` is what turns it into a 500 instead.
COPY fonts ./fonts

# `scripts/sync-packs.mjs` — the step that puts the published packs on the mounted volume, run on
# the machine and not at boot. It is COPYed here rather than only into the runtime stage so the
# image is one `COPY --from` below, the same bargain `fonts` takes.
COPY scripts ./scripts

RUN npm run build

# `npm prune --omit=dev` rather than a second `npm ci --omit=dev` in the runtime stage: the tree
# is already resolved and on disk, and pruning it cannot pick a different version than the one
# just built against.
RUN npm prune --omit=dev

FROM node:24.13.1-slim
ENV NODE_ENV=production
# Read at runtime by the standalone entry that `@astrojs/node` emits. `0.0.0.0` and not the
# default localhost: a server bound to the loopback inside a container answers nothing from
# outside it, and the symptom is a health check that times out with the process plainly running.
# `fly.toml`'s `internal_port` states the same 8080 and must move with it.
ENV HOST=0.0.0.0
ENV PORT=8080
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
# `/app/fonts`, and `WORKDIR /app` above is what makes that the `<cwd>/fonts` that
# `cardFontDir()` resolves to. Moving either one without the other serves cards with no text.
COPY --from=build /app/fonts ./fonts

# The volume is filled by running `node scripts/sync-packs.mjs` IN this container — `fly ssh
# console`, then that — so the script has to be in the image. It is not run at boot and must not
# be: 713 MB over a cold network is not something a health check can wait for, and a server that
# fetches its own data at startup fails to start on the day the bucket has a bad minute.
#
# **`src` comes with it, and that is the whole reason this is two COPY lines instead of one.** The
# script imports `src/lib/pack/manifest.ts`, `bucket.ts`, `versions.ts` and `packLibrary.ts` rather
# than carrying its own copy of the catalog decoder, the pack generation it will accept, or the
# name of `CYPRESS_PACK_DIR` — one definition each, which is why the server and the sync can never
# disagree about them. `dist/` is the bundle Astro emitted and does not contain those modules in a
# form anything can import, so `src` is what the script reads. It is TypeScript source for a public
# read surface, not a secret, and `test/sync-packs.test.ts` asserts both directories arrive: a
# script in the image whose imports are not is a script that fails on the one night it is needed.
COPY --from=build /app/src ./src
COPY --from=build /app/scripts ./scripts

# The `node` user exists in the official image. v1 is a read surface with no writes and no
# credentials, so this buys little today; it costs nothing and it is the wrong thing to add
# later, under pressure, on the day the app first opens a volume.
USER node

EXPOSE 8080
CMD ["node", "./dist/server/entry.mjs"]
